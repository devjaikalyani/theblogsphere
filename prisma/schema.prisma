generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id
  name           String
  firstName      String
  lastName       String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  password       String?
  googleId       String?  @unique
  image          String?
  profilePicture String   @default("/images/default-profile.png")
  bio            String?
  website        String?
  writingStyle   String?
  tippingEnabled Boolean  @default(false)
  tipUrl         String?
  upiId          String?  // UPI VPA for India-native tipping (receive-only)

  // Email me when a writer I follow publishes a new story. Off switch is a
  // signed one-click unsubscribe link in every notification email.
  notifyFollowedPosts Boolean @default(true)

  // The weekly "best of TheBlogSphere" digest email. Same one-click signed
  // unsubscribe as the publish notifications.
  notifyWeeklyDigest Boolean @default(true)

  // Monetization: platform subscription (Writer Pro) + AI usage metering
  plan                   String    @default("free") // "free" | "writer" | "pro"
  planRenewsAt           DateTime?
  billingProvider        String?   // "stripe" | "razorpay", which gateway owns the sub
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  aiUsageCount           Int       @default(0)
  aiUsagePeriodStart     DateTime?
  narrationCount         Int       @default(0) // lifetime count of narrations generated (analytics only)
  // Narration is metered by characters (what the TTS provider actually bills),
  // so the cost ceiling holds regardless of article length. Re-listening to an
  // already-narrated story is free for everyone (audio is cached); only new
  // generation draws these down. Free: a lifetime taste. Pro: a monthly budget
  // (resets like aiUsage) plus any prepaid top-up credits, spent after it.
  narrationCharsUsed     Int       @default(0) // pro: chars generated this window; free: lifetime chars generated
  narrationPeriodStart   DateTime?             // pro monthly narration window start (lazy reset)
  narrationCreditChars   Int       @default(0) // prepaid top-up characters (carry over; spent after the monthly budget)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  blogs          Blog[]
  sessions       Session[]
  accounts       Account[]
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  following      Follow[]  @relation("Follower")
  followers      Follow[]  @relation("Following")
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String?   @unique
  content     String
  author      String
  publishDate DateTime?
  visibility  String    @default("public")
  status      String    @default("published")
  coverImage  String?
  views       Int       @default(0)
  deletedAt   DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        BlogTag[]
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       Like[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // Hot path: public listings ordered by recency (explore/home/feed)
  @@index([visibility, status, publishDate])
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  slug  String    @unique
  blogs BlogTag[]
}

model BlogTag {
  blogId Int
  tagId  Int
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model Bookmark {
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([userId, blogId])
  @@index([userId])
}

model Like {
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([userId, blogId])
  @@index([blogId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// Better Auth tables
model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// In-app content reports / DMCA & abuse takedown requests (IT Rules 2021).
// Kept as plain columns (no FKs) so a report survives as a moderation-log entry
// even after the reported post or the reporter's account is deleted.
model Report {
  id            Int      @id @default(autoincrement())
  blogId        Int?     // the reported story, if applicable
  reporterId    String?  // set when the reporter was signed in
  reporterEmail String?  // required when the reporter was anonymous
  reason        String   // spam | harassment | copyright | illegal | misinformation | other
  details       String?
  status        String   @default("open") // open | reviewing | actioned | dismissed
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([blogId])
}

// Reader-confirmed UPI tips. The money moves directly reader -> writer over
// UPI (the platform is never a party to it and takes no cut), so rows here are
// self-reported confirmations, not verified transactions. They power the
// per-story tip counts and the public "writers earned this month" posts. No
// FKs on purpose: the earnings log survives account and story deletion.
model Tip {
  id         Int      @id @default(autoincrement())
  blogId     Int
  writerId   String
  reporterId String?  // signed-in reader who confirmed; null when anonymous
  amount     Int      // rupees, as reported by the reader
  createdAt  DateTime @default(now())

  @@index([blogId])
  @@index([writerId])
  @@index([createdAt])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Billing idempotency ledger: payment ids and webhook event ids that were
// already applied, so gateway retries and double-submitted verifies can't
// double-grant (or extend) Pro. The @id unique constraint IS the lock.
model BillingEvent {
  id        String   @id // gateway payment id or webhook event id
  provider  String   // "razorpay" | "stripe"
  kind      String   // "payment" | "webhook"
  createdAt DateTime @default(now())
}
