generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id
  name           String
  firstName      String
  lastName       String
  email          String   @unique
  emailVerified  Boolean  @default(false)
  password       String?
  googleId       String?  @unique
  image          String?
  profilePicture String   @default("/images/default-profile.png")
  bio            String?
  website        String?
  writingStyle   String?
  tippingEnabled Boolean  @default(false)
  tipUrl         String?
  upiId          String?  // UPI VPA for India-native tipping (receive-only)

  // Monetization — platform subscription (Writer Pro) + AI usage metering
  plan                   String    @default("free") // "free" | "pro"
  planRenewsAt           DateTime?
  billingProvider        String?   // "stripe" | "razorpay" — which gateway owns the sub
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  razorpayCustomerId     String?
  razorpaySubscriptionId String?
  aiUsageCount           Int       @default(0)
  aiUsagePeriodStart     DateTime?
  narrationCount         Int       @default(0) // lifetime neural-narration uses (free tier: 5, then Pro)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  blogs          Blog[]
  sessions       Session[]
  accounts       Account[]
  bookmarks      Bookmark[]
  comments       Comment[]
  likes          Like[]
  following      Follow[]  @relation("Follower")
  followers      Follow[]  @relation("Following")
}

model Blog {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String?   @unique
  content     String
  author      String
  publishDate DateTime?
  visibility  String    @default("public")
  status      String    @default("published")
  coverImage  String?
  views       Int       @default(0)
  deletedAt   DateTime?
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        BlogTag[]
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       Like[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  // Hot path: public listings ordered by recency (explore/home/feed)
  @@index([visibility, status, publishDate])
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique
  slug  String    @unique
  blogs BlogTag[]
}

model BlogTag {
  blogId Int
  tagId  Int
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
}

model Bookmark {
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([userId, blogId])
  @@index([userId])
}

model Like {
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@id([userId, blogId])
  @@index([blogId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  userId    String
  blogId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog      Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([userId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User @relation("Follower",  fields: [followerId],  references: [id], onDelete: Cascade)
  following   User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// Better Auth tables
model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// In-app content reports / DMCA & abuse takedown requests (IT Rules 2021).
// Kept as plain columns (no FKs) so a report survives as a moderation-log entry
// even after the reported post or the reporter's account is deleted.
model Report {
  id            Int      @id @default(autoincrement())
  blogId        Int?     // the reported story, if applicable
  reporterId    String?  // set when the reporter was signed in
  reporterEmail String?  // required when the reporter was anonymous
  reason        String   // spam | harassment | copyright | illegal | misinformation | other
  details       String?
  status        String   @default("open") // open | reviewing | actioned | dismissed
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([blogId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
