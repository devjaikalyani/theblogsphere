{
  "name": "the-blog-sphere",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:TheBlogSphere": "node dist/the-blog-sphere/server/server.mjs",
    "server:dev": "node --import @swc-node/register/esm-register server/src/main.ts",
    "server:build": "npx prisma generate",
    "server:start": "NODE_ENV=production node --import @swc-node/register/esm-register server/src/main.ts",
    "dev": "concurrently --names \"frontend,server\" --prefix-colors \"cyan,yellow\" \"npm run start\" \"npm run server:dev\"",
    "backfill:slugs": "node --import @swc-node/register/esm-register server/src/scripts/backfill-slugs.ts",
    "db:trigram": "node --import @swc-node/register/esm-register server/src/scripts/apply-trigram.ts",
    "prisma:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "prisma:push": "npx prisma db push",
    "prisma:studio": "npx prisma studio"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.39",
    "@angular/animations": "^19.2.25",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/ssr": "^19.2.4",
    "@aws-sdk/client-s3": "^3.799.0",
    "@aws-sdk/lib-storage": "^3.799.0",
    "@aws-sdk/s3-request-presigner": "^3.799.0",
    "@nestjs/common": "^11.0.21",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.21",
    "@nestjs/platform-express": "^11.0.21",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.9.0",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.40",
    "@swc/helpers": "^0.5.23",
    "ai": "^6.0.197",
    "better-auth": "^1.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "concurrently": "^9.2.1",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "glob": "^11.0.1",
    "helmet": "^8.2.0",
    "marked": "^18.0.5",
    "motion": "^12.42.0",
    "multer": "^1.4.5-lts.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "rxjs": "~7.8.0",
    "stripe": "^22.3.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/cli": "^19.2.4",
    "@angular/compiler-cli": "^19.2.25",
    "@nestjs/cli": "^11.0.21",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.18.0",
    "@types/qrcode": "^1.5.6",
    "ajv": "^8.20.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.15",
    "prisma": "^6.9.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "~5.7.2"
  }
}
