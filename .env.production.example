# ──────────────────────────────────────────────────────────────────────────
# TheBlogSphere — Railway backend (NestJS API) environment
#
# Paste this into Railway → backend service → Variables → "Raw Editor", then
# replace every <…> placeholder with a real value. (This file is a template —
# never commit real secrets.)
#
# IMPORTANT: the origin URLs below are your PUBLIC Vercel domain, NOT the
# Railway domain. The browser only ever talks to Vercel, which proxies /api/*
# to this backend (see vercel.json). Auth cookies + Google OAuth depend on
# every origin value matching the domain the user actually visits.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Railway injects PORT automatically — do NOT set it here.

# Database — reference the Railway PostgreSQL plugin. Keep the ${{ }} syntax;
# change "Postgres" only if you renamed the database service.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Public origin (your Vercel domain) — identical value in all four:
BETTER_AUTH_URL=https://theblogsphere.vercel.app
ALLOWED_ORIGINS=https://theblogsphere.vercel.app
SITE_URL=https://theblogsphere.vercel.app
GOOGLE_CALLBACK_URL=https://theblogsphere.vercel.app/api/auth/callback/google

# Better Auth — session signing secret (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=<long-random-secret>

# Google OAuth — whitelist the callback URL above (and the Vercel JS origin)
# in the Google Cloud console
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Groq AI — use a freshly rotated key
GROQ_API_KEY=<your-groq-api-key>

# Cloudflare R2 — allow the Vercel origin in the bucket's CORS policy
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-bucket-name>
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Stripe — Writer Pro subscription billing. OPTIONAL: leave unset and the app
# runs on the free tier only (upgrade buttons return "billing not configured").
# 1. Create a recurring Product/Price in the Stripe dashboard -> copy its price id.
# 2. Add an endpoint at <your-domain>/api/billing/webhook -> copy its signing secret.
# 3. APP_URL is where Stripe Checkout returns the user (your public Vercel domain).
STRIPE_SECRET_KEY=<sk_live_or_test_...>
STRIPE_PRICE_PRO=<price_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
APP_URL=https://theblogsphere.vercel.app

# Optional — pin Node 22 (silences the AWS SDK "<22" warning)
NIXPACKS_NODE_VERSION=22
