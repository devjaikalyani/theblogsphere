# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/callback/google

# Better Auth — secret used to sign sessions (generate a long random string)
BETTER_AUTH_SECRET=a_long_random_secret_string

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Better Auth — must match your production domain
BETTER_AUTH_URL=https://yourdomain.com

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Razorpay — Writer Pro billing for India (INR / UPI). OPTIONAL: leave unset and
# the gateway is hidden on the pricing page. Partial config fails boot on purpose.
# 1. Dashboard -> Account & Settings -> API Keys -> Generate Key (rzp_test_* first).
# 2. Subscriptions -> Plans -> Create Plan (monthly, INR) -> copy its plan_... id.
# 3. Account & Settings -> Webhooks -> add <your-domain>/api/billing/razorpay-webhook,
#    subscribe to subscription.* events, copy the webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO=
RAZORPAY_WEBHOOK_SECRET=

# Stripe — international card billing. OPTIONAL, same pattern; see
# .env.production.example for the setup steps.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# Resend — password-reset emails. OPTIONAL: unset means reset requests still
# answer 200 (no account enumeration) but no email is sent (a warning is
# logged). Get a key at https://resend.com; EMAIL_FROM must be a verified
# sender/domain there.
RESEND_API_KEY=
EMAIL_FROM=

# Server port (optional, defaults to 3000)
PORT=3000
